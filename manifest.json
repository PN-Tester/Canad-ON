{
  "manifest_version": 3,
  "name": "Canad/ON Region Spoofer",
  "version": "2.0.0",
  "description": "Forces the 'region' query parameter on maps.googleapis.com requests to CA when toggled on. Patches fetch/XHR/script-src in-page and backstops with a network rule.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "maple-leaf.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-isolated.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
